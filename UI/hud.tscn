[gd_scene format=3 uid="uid://hud_overlay"]

[ext_resource type="Script" path="res://UI/hud.gd" id="1_hudgd"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hudgd")

[node name="NightOverlay" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0.02, 0.08, 0)
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="."]
offset_right = 180.0
offset_bottom = 88.0

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="LabelNickname" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Pseudo: "

[node name="LabelHealth" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Santé: 4"

[node name="LabelMovement" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Mvt: 50"

[node name="LabelComputers" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Ordinateurs: 0"

[node name="LabelRobots" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Robots: 0"

[node name="LabelZone" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Zone: "

[node name="LabelPosition" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Pos: "

[node name="LabelMode" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Mode: Marche"

[node name="TopBar" type="PanelContainer" parent="."]
offset_left = 760.0
offset_top = 4.0
offset_right = 1088.0
offset_bottom = 36.0

[node name="HBox" type="HBoxContainer" parent="TopBar"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="BtnSheet" type="Button" parent="TopBar/HBox"]
layout_mode = 2
custom_minimum_size = Vector2(90, 0)
theme_override_font_sizes/font_size = 13
text = "Fiche"

[node name="BtnArmory" type="Button" parent="TopBar/HBox"]
layout_mode = 2
custom_minimum_size = Vector2(90, 0)
theme_override_font_sizes/font_size = 13
text = "Armurerie"

[node name="BtnSetting" type="Button" parent="TopBar/HBox"]
layout_mode = 2
custom_minimum_size = Vector2(90, 0)
theme_override_font_sizes/font_size = 13
text = "Paramètres"

[node name="BtnHome" type="Button" parent="TopBar/HBox"]
layout_mode = 2
custom_minimum_size = Vector2(90, 0)
theme_override_font_sizes/font_size = 13
text = "Accueil"

[node name="ClockAnchor" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="ClockPanel" type="PanelContainer" parent="ClockAnchor"]
layout_mode = 1
anchor_left = 0.5
anchor_right = 0.5
anchor_top = 0.0
anchor_bottom = 0.0
offset_left = -170.0
offset_top = 4.0
offset_right = 170.0
offset_bottom = 40.0
grow_horizontal = 2

[node name="HBox" type="HBoxContainer" parent="ClockAnchor/ClockPanel"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_override_constants/separation = 8

[node name="LabelClock" type="Label" parent="ClockAnchor/ClockPanel/HBox"]
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 18
text = "--/--/----  --h--"
horizontal_alignment = 1

[connection signal="pressed" from="TopBar/HBox/BtnSheet" to="." method="_on_btn_sheet_pressed"]
[connection signal="pressed" from="TopBar/HBox/BtnArmory" to="." method="_on_btn_armory_pressed"]
[connection signal="pressed" from="TopBar/HBox/BtnSetting" to="." method="_on_btn_setting_pressed"]
[connection signal="pressed" from="TopBar/HBox/BtnHome" to="." method="_on_btn_home_pressed"]
